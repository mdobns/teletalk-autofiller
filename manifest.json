{
  "manifest_version": 3,
  "name": "Teletalk Autofiller - BD Govt Job Autofill",
  "version": "2.0.0",
  "version_name": "beta 2.0",
  "description": "One-click intelligent autofill for Bangladesh Government Job applications on all Teletalk recruitment portals (*.teletalk.com.bd)",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "512": "icons/icon512.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Teletalk Autofiller",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png",
      "512": "icons/icon512.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.teletalk.com.bd/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.teletalk.com.bd/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/bd_geo.json",
        "data/reference_lists.json",
        "data/sample_profile.json",
        "icons/*"
      ],
      "matches": [
        "*://*.teletalk.com.bd/*"
      ]
    }
  ]
}
